# =============================================================================
# Environment variables. Copy to `.env.local` for local development.
# NEVER commit real values. Set production values in the Vercel project
# settings (separately for Production and Preview environments).
# Variables prefixed NEXT_PUBLIC_ are embedded in browser bundles: never put a
# secret in one.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Canonical origin of the site, no trailing slash. Used for canonical URLs,
# sitemap, Open Graph and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on the production deployment. Anything else serves
# `Disallow: /` and an `X-Robots-Tag: noindex` header (previews, staging).
ALLOW_INDEXING=false

# --- Brand (all optional; defaults live in src/config/brand.ts) --------------
# The default name is "Werks & Marque"; set this only to override it.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_PUBLISHER_NAME=
# Public editorial contact address shown in the footer.
NEXT_PUBLIC_EDITORIAL_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_X_URL=

# --- Supabase ---------------------------------------------------------------
# Project URL (Project Settings > API). Local: http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET (service role) key. Server only. Bypasses RLS. Used for submission
# inserts, rate limiting and the create-admin script. Never expose it.
SUPABASE_SECRET_KEY=

# --- Submissions & abuse protection ------------------------------------------
# Random string (>= 16 chars) used to salt hashes of IP addresses / emails for
# rate limiting. Generate with: openssl rand -hex 32. Rotating it resets limits.
SUBMISSION_HASH_SALT=

# Optional Cloudflare Turnstile. If both are set the form requires a challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Resend) -----------------------------------------------------------
# Without these, submissions are still stored and marked notification_status =
# 'skipped'. Editors will not get email alerts until configured.
RESEND_API_KEY=
# Verified sender, e.g. "Werks & Marque <editors@yourdomain.com>"
EMAIL_FROM=
# Comma-separated list of editorial recipients for new-submission alerts.
EDITORIAL_NOTIFY_EMAIL=

# --- Analytics (optional) -----------------------------------------------------
# "ga4", "plausible", or "none".
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Required when provider=ga4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for self-hosted Plausible; defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
# "true" shows a consent banner and loads analytics only after opt-in.
# Recommended true for ga4 (cookies). Plausible is cookieless.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=false

# --- Tooling (local development and CI only; not used at runtime) -------------
# Allows scripts/seed-dev.ts to run. Only honoured for localhost Supabase URLs.
# SEED_ALLOW=local
